# ==============================================================================
# Wishverse Frontend - Environment Variables Template
# ==============================================================================

# API Base URL:
# Leave blank or '/api' when deploying full-stack via Docker (Render / Cloud Run)
# Or set to full backend URL when frontend is hosted separately (e.g. on Vercel or Netlify)
# Example: VITE_API_URL=https://wishverse-api.onrender.com/api
VITE_API_URL=/api

# Local dev proxy target (optional)
# VITE_BACKEND_URL=http://127.0.0.1:8000
