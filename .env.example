# ==============================================================================
# Wishverse V1 - Environment Variables Template
# ==============================================================================

# Application Metadata
PROJECT_NAME="Wishverse API"
VERSION="1.0.0"
API_V1_STR="/api"

# Security & Authentication
# Generate with: openssl rand -hex 32
# NEVER reuse a key that has appeared in a committed file, chat log, or
# screenshot - generate a fresh one for every real deployment.
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Local Development (SQLite):
DATABASE_URL="sqlite:///./wishverse.db"
# Production (Supabase / Render PostgreSQL):
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_SUPABASE_PROJECT.supabase.co:5432/postgres"

# CORS Configuration
# Recommended (production): restrict to your real frontend origin(s)
BACKEND_CORS_ORIGINS='["http://localhost:5173", "https://your-frontend.vercel.app", "https://wishverse.onrender.com"]'
# Only use "*" for quick local testing - never in a real production deployment
# BACKEND_CORS_ORIGINS="*"

# Upload Limits & File Storage
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_MB=25

# Supabase Storage Integration (Optional)
# SUPABASE_URL="https://YOUR_SUPABASE_PROJECT.supabase.co"
# SUPABASE_KEY="YOUR_SUPABASE_ANON_OR_SERVICE_KEY"
# SUPABASE_BUCKET="wish-media"

# Deployment Port (automatically provided by Render / Cloud Run)
PORT=8000
